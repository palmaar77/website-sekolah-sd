# PostgreSQL Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Dapat menggunakan database PostgreSQL lokal, Supabase, Neon, atau Vercel Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sd_harapan_bangsa?schema=public"

# Rahasia JWT untuk Autentikasi Admin (Minimal 32 karakter acak)
JWT_SECRET="sd-harapan-bangsa-super-secret-production-jwt-key-2025-secure-token"

# Base URL Website
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Kredensial Akun Administrator Awal (digunakan saat menjalankan: npm run seed)
ADMIN_NAME="Administrator Sekolah"
ADMIN_EMAIL="admin@sdharapanbangsa.sch.id"
ADMIN_PASSWORD="AdminSekolah2025!Secure"
